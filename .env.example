# Copie para `.env` e preencha com o painel Supabase (Project Settings → API).

EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# true = permite "Liberar (teste admin)" no app (só use em dev)
# false = desliga no client (produção / eas.json production já força false)
EXPO_PUBLIC_ALLOW_ADMIN_GRANT=true
